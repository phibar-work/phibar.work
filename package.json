{
  "name": "phibar-work",
  "version": "1.13.0",
  "packageManager": "pnpm@10.28.1",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:storybook",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit",
    "test:storybook": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project storybook",
    "test:unit:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit --coverage",
    "coverage": "pnpm run test:unit:coverage",
    "coverage:open": "pnpm run coverage && open coverage/index.html",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "lhci autorun --collect.url=http://localhost:3000/",
    "analyze": "cross-env ANALYZE=true pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.7",
    "graphql": "^16.14.2",
    "lucide-react": "^1.56.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "copyfiles": "^2.4.1",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "playwright-core": "1.64.0",
    "postcss": "^8.5.30",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 15",
    "Edge >= 100"
  ]
}
